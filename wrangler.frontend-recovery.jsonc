{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "deploy/cloudflare/frontend-recovery.mjs",
  "compatibility_date": "2026-11-16",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.codex666.net", "custom_domain": true }],
  "assets": {
    "directory": "./backend/internal/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "SUB2API", "class_name": "Sub2APIContainer" }]
  },
  "exports": { "Sub2APIContainer": { "type": "durable-object", "storage": "sqlite" } },
  "observability": { "enabled": true }
}
